# Source only. Secrets must remain on VPS and never be committed.
# OFF by default; enables ONLY /login, /logout, and custom-preset edits
# under VPS1_RUNTIME_CANDIDATE=1, still without jobs or workers.
VPS1_SCENE_PRECUTOVER_EDITING=0
WEB_ACCESS_KEY=
SESSION_SECRET=
SCENE_RUNTIME_PROBE_TOKEN=
WEB_DATA_DIR=/var/lib/fresh-website/scene-builder/web
SCENE_PERMANENT_ROOT=/var/lib/fresh-website/scene-builder/permanent
SCRIPT_WORK_DATA_DIR=/var/lib/fresh-website/scene-builder/script-work
MASTER_CONTROLLER_DB_PATH=/var/lib/fresh-website/scene-builder/master-controller.sqlite3
ATOMIC_FLOW_DB_PATH=/var/lib/fresh-website/scene-builder/atomic-flow.sqlite3
AUTOFLOW_FLOW_RESULT_ROOT=/var/lib/fresh-website/scene-builder/flow-results
SCENE_CHANNELS_FILE=/var/lib/fresh-website/scene-builder/channels.json
WORKER_URL=http://127.0.0.1:1
WORKER_TOKEN=
SCRIPT_WORK_GOOGLE_FOLDER_ID=
